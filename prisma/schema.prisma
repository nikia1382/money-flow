generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Account {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  balance   BigInt   @default(0)
  number    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}